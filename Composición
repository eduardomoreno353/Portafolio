class Empleado:
    def __init__(self, nombre, salario):
        self.nombre = nombre
        self.salario = salario

    def trabajar(self):
        return f"{self.nombre} está trabajando."

# Desarrollador hereda de Empleado
class Desarrollador(Empleado):
    def __init__(self, nombre, salario, lenguaje):
        # super() llama al constructor de la clase padre
        super().__init__(nombre, salario) 
        self.lenguaje = lenguaje

    def programar(self):
        return f"{self.nombre} está escribiendo código en {self.lenguaje}."

dev = Desarrollador("Ana", 50000, "Python")
print(dev.trabajar())  # Método heredado
print(dev.programar()) # Método específico de la clase hija
